/* Private user code ---------------------------------------------------------*/
/* USER CODE BEGIN 0 */
// 这个函数可以进行 11 位一组切出来，并减去 1024
//串口发的数据是八位，但是摇杆的位置需�?11�?
//0x07FF:保留11�??
void BufToChannel(void) {
  CH[0] = ((((int16_t)buf_copy[1] >> 0) | ((int16_t)buf_copy[2] << 8)) & 0x07FF) - 1024;
  CH[1] = ((((int16_t)buf_copy[2] >> 3) | ((int16_t)buf_copy[3] << 5)) & 0x07FF) - 1024;
  CH[2] = ((((int16_t)buf_copy[3] >> 6) | ((int16_t)buf_copy[4] << 2) | ((int16_t)buf_copy[5] << 10)) & 0x07FF) - 1024;
  CH[3] = ((((int16_t)buf_copy[5] >> 1) | ((int16_t)buf_copy[6] << 7)) & 0x07FF) - 1024;
  CH[4] = ((((int16_t)buf_copy[6] >> 4) | ((int16_t)buf_copy[7] << 4)) & 0x07FF) - 1024;
  CH[5] = ((((int16_t)buf_copy[7] >> 7) | ((int16_t)buf_copy[8] << 1) | ((int16_t)buf_copy[9] << 9)) & 0x07FF) - 1024;
  CH[6] = ((((int16_t)buf_copy[9] >> 2) | ((int16_t)buf_copy[10] << 6)) & 0x07FF) - 1024;
  CH[7] = ((((int16_t)buf_copy[10] >> 5) | ((int16_t)buf_copy[11] << 3)) & 0x07FF) - 1024;
  CH[8] = ((((int16_t)buf_copy[12] >> 0) | ((int16_t)buf_copy[13] << 8)) & 0x07FF) - 1024;
  CH[9] = ((((int16_t)buf_copy[13] >> 3) | ((int16_t)buf_copy[14] << 5)) & 0x07FF) - 1024;
}
/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_USART3_UART_Init();
  MX_CAN1_Init();
  /* USER CODE BEGIN 2 */

  // 1. 配置发送报文头 (控制1号电调用)
  motor1_txconf.StdId = 0x200;// 标准帧ID，控制1~4号电调
  motor1_txconf.IDE = CAN_ID_STD;   // 标准帧
  motor1_txconf.RTR = CAN_RTR_DATA;   // 数据帧
  motor1_txconf.DLC = 8;     // 数据长度8字节
  motor1_txconf.TransmitGlobalTime = DISABLE;

  // 2. 配置CAN1过滤器（只接收0x201电调反馈）
  CAN_FilterTypeDef can1_filter;
  
  can1_filter.FilterMode = CAN_FILTERMODE_IDLIST; // 列表模式
  can1_filter.FilterScale = CAN_FILTERSCALE_16BIT; // 16位宽度
  can1_filter.FilterFIFOAssignment = CAN_RX_FIFO1; // 存入FIFO1
  can1_filter.FilterBank = 0;               // 使用第0组过滤器
  can1_filter.SlaveStartFilterBank = 14;     // 0~13给CAN1，14~27给CAN2
  
  // 将0x201左移5位，填满4个匹配项
  can1_filter.FilterIdHigh = (0x201 << 5); // 16位模式下，高寄存器放标准ID
  can1_filter.FilterIdLow = (0x201 << 5); 
  can1_filter.FilterMaskIdHigh = (0x201 << 5); // 列表模式下，Mask也填ID
  can1_filter.FilterMaskIdLow = (0x201 << 5);
  can1_filter.FilterActivation = ENABLE;       // 开启过滤器

  // 3. 将过滤器配置写入硬件
  if (HAL_CAN_ConfigFilter(&hcan1, &can1_filter) != HAL_OK)
  {
  // 如果配置失败，进入死循环
      Error_Handler();
  }

  // 4. 启动CAN1
  if (HAL_CAN_Start(&hcan1) != HAL_OK)
  {
      Error_Handler();
  }

  // 5. 开启FIFO1接收中断（电调反馈存在FIFO1）
  if (HAL_CAN_ActivateNotification(&hcan1, CAN_IT_RX_FIFO1_MSG_PENDING) != HAL_OK)
  {
      Error_Handler();
  }
  
  // 算正弦波
  float phase = 0.0f;
  int16_t current_cmd = 0;





  //启动串口DMA空闲中断接收
HAL_UARTEx_ReceiveToIdle_DMA(&huart3,buf,25);
//关闭半传输中断（设计漏洞�??
__HAL_DMA_DISABLE_IT(huart3.hdmarx,DMA_IT_HT);
last_frame_tick = HAL_GetTick();//先记�?下时间，避免�?上电就离�?

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    if(data_ready_flag==1){
      data_ready_flag=0;

      start_byte = buf_copy[0]; // 帧头 0x0F
        
     BufToChannel(); // 调用解析函数，把数据塞进 CH 数组
        
    flag_byte = buf_copy[23];
        stop_byte = buf_copy[24];
        
        // 把解析出来的值赋�?
    rc_data.rocker_r_ = CH[0]; 
    rc_data.rocker_r1 = CH[1]; 
    rc_data.rocker_l1 = CH[2]; 
    rc_data.rocker_l_ = CH[3]; 
    rc_data.SWA       = CH[4];
    rc_data.SWB       = CH[5];
    rc_data.SWC       = CH[6];
    rc_data.SWD       = CH[7];
   rc_data.VRA       = CH[8];
    rc_data.VRB       = CH[9];
        
        // 状�?�改变标志位（用位运算抠出来�?
        rc_data.error_protect = (flag_byte >> 3) & 0x01;
        rc_data.byte_lose     = (flag_byte >> 2) & 0x01;
    }
    //超过100ms没收到新的，就认为遥控器断开了（要求�?100ms处理�?
  
    if(HAL_GetTick() - last_frame_tick > 100){//本来用的后面发现错了
      rc_data.offline = 1;
    }else{
      rc_data.offline = 0;
    }
  }

//第五周主循环
    // 1. 生成正弦变化的电流指令 (幅值1000)
    current_cmd = (int16_t)(1000.0f * sinf(phase));
    phase += 0.02f * 3.14159265f; // 调整正弦波的频率
    if (phase > 2.0f * 3.14159265f) {
        phase -= 2.0f * 3.14159265f; // 防止phase一直增加导致浮点数溢出
    }

    // 2. 判断CAN1是否有空闲发送邮箱
    if (HAL_CAN_GetTxMailboxesFreeLevel(&hcan1) > 0)
    {
        // 3. 组装数据 (1号电调占 DATA[0] 和 DATA[1])
        // 必须把 int16_t 强转为 uint16_t，方便位移操作
        uint16_t raw_current = (uint16_t)current_cmd; 
        
        // 高字节在前
        can1_tx_buff[0] = (uint8_t)(raw_current >> 8);
        // 低字节在后
        can1_tx_buff[1] = (uint8_t)(raw_current & 0xFF);
        
        // 因为没有接2、3、4号电调，剩下的字节填0
        for (uint8_t i = 2; i < 8; i++) {
            can1_tx_buff[i] = 0;
        }

        // 4. 发送报文
        HAL_CAN_AddTxMessage(&hcan1, &motor1_txconf, can1_tx_buff, &tx_mailbox);
    }
    
    // 5. 延时10ms
    HAL_Delay(10);
}



  /* USER CODE END 3 */
}

