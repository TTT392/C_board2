//结构体存电机数据
typedef struct{
  uint16_t ecd;//编码器值（8191）
  int16_t speed_rpm;//转速
  int16_t real_current;//实际电流
  int16_t real_current_handle;//滤波后的电流
  uint8_t temperature;//温度

}motor_measure_t
/* USER CODE END PTD */

/* Private define ------------------------------------------------------------*/
/* USER CODE BEGIN PD */
typedef struct {
int16_t rocker_l_;
int16_t rocker_l1;
int16_t rocker_r_;
int16_t rocker_r1;
int16_t SWA;
int16_t SWB;
int16_t SWC;
int16_t SWD;
int16_t VRA;
int16_t VRB;
uint8_t error_protect;
uint8_t byte_lose;//真丢失标志位
uint8_t offline;//超过100ms没收到有效帧就置1


}RC_ctrl_t;

static RC_ctrl_t rc_data;//遥控�?

int16_t CH[16];//存放解析后的16个�?�道数据
uint8_t start_byte,flag_byte,stop_byte;//代表状�?�的变量
/* USER CODE END PD */

/* Private macro -------------------------------------------------------------*/
/* USER CODE BEGIN PM */

/* USER CODE END PM */

/* Private variables ---------------------------------------------------------*/
CAN_HandleTypeDef hcan1;

UART_HandleTypeDef huart3;
DMA_HandleTypeDef hdma_usart3_rx;

/* USER CODE BEGIN PV */
motor_measure_t motor1_measure;

uint8_t can1_tx_buff[8];
uint8_t can1_rx_buff[8];

CAN_TxHeaderTypeDef motor1_txconf;//发送报文头配置
uint32_t tx_mailbox;             //发送邮箱编号（发送时要传这个参数）




volatile uint8_t data_ready_flag = 0;
uint8_t buf[25];//DMA接收
uint8_t buf_copy[25];//临时储存
volatile uint32_t last_frame_tick = 0;//�?后一次收到有效帧的时�?
/* USER CODE END PV */

